MOBILITYDATABASE_REFRESH_TOKEN=change_in_prod
SCRAPPA_API_KEY=change_in_prod
APP_ACCESS_TOKEN=change_in_prod
# Backend trace logging: TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL; text or json.
LOG_LEVEL=INFO
LOG_FORMAT=text
# Optional persistent diagnostics (5 MB rotation, 3 backups); ignored local data directory.
# LOG_FILE=backend/data/logs/search.jsonl
# Server-only frontend configuration. Local next dev also reads these from this root file.
BACKEND_GRAPHQL_URL=http://127.0.0.1:8000/graphql
SCHEDULE_SNAPSHOT_PATH=/absolute/path/to/schedules.sqlite
SCHEDULE_MAX_AGE_SECONDS=86400
# Optional overrides; local development defaults to the existing fixture artifacts.
REFERENCE_GRAPH_PATH=/absolute/path/to/base_graph.pickle
FORECAST_MODELS_PATH=/absolute/path/to/forecast_models.json
STAGING_DATA_DIRECTORY=/absolute/path/to/staging-data
